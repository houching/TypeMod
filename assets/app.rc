1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TypeMod - Windows System Font Replacement & Metrics Tool"
            VALUE "FileVersion", "0.1.1"
            VALUE "InternalName", "typemod"
            VALUE "LegalCopyright", "Copyright (c) 2026 Houching. Licensed under Apache-2.0."
            VALUE "OriginalFilename", "typemod.exe"
            VALUE "ProductName", "TypeMod"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
